# Configuration template; no credentials included.
# Copy to .env.local after scaffold; keep local secrets gitignored.
# Defaults below are planning defaults, not provider capacity guarantees.
# Google OAuth client secrets are entered in Supabase provider settings.
# Tenant goals/timezone/platforms/availability live in the database, not here.
# Implementation adds documented structured freshness/retry/design configuration as needed.

# string; server/public; default/status: required. Product display name.
APP_NAME=

# enum; server; default/status: development. development/staging/production.
APP_ENV=development

# URL; server; default/status: required. Public canonical origin and redirect validation.
APP_URL=

# enum; server; default/status: info. Redacted structured log verbosity (debug/info/warn/error).
LOG_LEVEL=info

# integer; server; default/status: 2000. Per-dependency timeout for /api/v1/ready probes.
READINESS_TIMEOUT_MS=2000

# URL; public; default/status: required. Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# string; public; default/status: required. Publishable key; RLS mandatory.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# secret; server; default/status: required when APP_ENV is staging/production (optional in development). Never browser; used only for owner review and account-record repair.
SUPABASE_SECRET_KEY=

# secret URL; server/tooling; default/status: optional. Only direct SQL migration tooling if required.
DATABASE_URL=

# enum; server; default/status: supabase. Initial supported identity adapter.
AUTH_PROVIDER=supabase

# enum; server; default/status: supabase. Durable queue adapter.
QUEUE_PROVIDER=supabase

# string; server; default/status: required when jobs enabled. Deployed queue identifier.
QUEUE_NAME=

# secret; server; default/status: required when jobs enabled. Authenticated worker trigger; also secret store.
WORKER_SHARED_SECRET=

# integer; server; default/status: 1. Maximum claims per bounded invocation.
WORKER_BATCH_SIZE=1

# integer; server; default/status: 3. Capped job retries.
JOB_MAX_ATTEMPTS=3

# integer; server; default/status: 120. Renewable lease; align to measured operation limits.
JOB_LEASE_SECONDS=120

# integer; server; default/status: 60. Configured protected recovery schedule.
JOB_RECOVERY_INTERVAL_SECONDS=60

# boolean; server; default/status: false. Enable only after credentials and budgets configured.
LLM_ENABLED=false

# enum; server; default/status: groq. Initial supported LLM adapter.
LLM_PROVIDER=groq

# string; server; default/status: openai/gpt-oss-120b. Model preference; verify capabilities/availability.
LLM_MODEL=openai/gpt-oss-120b

# secret; server; default/status: required when enabled. Provider credential.
LLM_API_KEY=

# URL; server; default/status: optional. Approved API base override.
LLM_BASE_URL=

# integer; server; default/status: 30000. Per-call timeout; jobs checkpoint bounded stages.
LLM_TIMEOUT_MS=30000

# integer; server; default/status: 2. Transient retries within total budgets.
LLM_MAX_RETRIES=2

# integer; server; default/status: 3000. Pilot input budget; includes tool/schema overhead.
LLM_CONTEXT_TOKEN_BUDGET=3000

# integer; server; default/status: 1500. Pilot output reservation per bounded call.
LLM_MAX_OUTPUT_TOKENS=1500

# integer; server; default/status: 4. Bounded agent loop.
LLM_MAX_TOOL_STEPS=4

# integer; server; default/status: required when enabled. Set below current organization allowance.
LLM_GLOBAL_DAILY_TOKEN_CAP=

# integer; server; default/status: required when enabled. Admission limit per tenant; cannot exceed global.
LLM_WORKSPACE_DAILY_TOKEN_CAP=

# integer; server; default/status: required when enabled. Match verified account TPM with safety headroom.
LLM_GLOBAL_TOKENS_PER_MINUTE=

# integer; server; default/status: required when enabled. Match verified RPM with safety headroom.
LLM_GLOBAL_REQUESTS_PER_MINUTE=

# boolean; server; default/status: false. Enable after research adapter/limits ready.
RESEARCH_ENABLED=false

# enum; server; default/status: tavily. Search and extract adapter.
RESEARCH_PROVIDER=tavily

# secret; server; default/status: required when enabled. Research service credential.
RESEARCH_API_KEY=

# URL; server; default/status: optional. Approved API base override.
RESEARCH_BASE_URL=

# integer; server; default/status: 3. Initial bounded brief searches.
RESEARCH_MAX_SEARCHES_PER_RUN=3

# integer; server; default/status: 6. Selected/extracted source limit, not quality guarantee.
RESEARCH_MAX_SOURCES_PER_RUN=6

# integer; server; default/status: 2. Bounded recursive investigation depth.
RESEARCH_MAX_DEPTH=2

# integer; server; default/status: 30000. Per-stage retrieval timeout.
RESEARCH_TIMEOUT_MS=30000

# integer; server; default/status: required when enabled. Below account allowance, including extraction.
RESEARCH_GLOBAL_MONTHLY_CREDIT_CAP=

# integer; server; default/status: required when enabled. Tenant share of global research budget.
RESEARCH_WORKSPACE_MONTHLY_CREDIT_CAP=

# boolean; server; default/status: false. In-app first; email opt-in/provider setup required.
NOTIFICATION_EMAIL_ENABLED=false

# enum; server; default/status: resend. Initial supported sending adapter.
EMAIL_PROVIDER=resend

# secret; server; default/status: required when email enabled. Email service credential.
EMAIL_API_KEY=

# email identity; server; default/status: required when email enabled. Verified sending-domain identity.
EMAIL_FROM=

# integer; server; default/status: 25. Default bounded cursor result page.
LIST_PAGE_SIZE=25

# integer; server; default/status: 42. Maximum normal calendar query range.
CALENDAR_MAX_RANGE_DAYS=42

# integer; server; default/status: required before production. Reviewed policy for conversational/evidence records.
AI_RETENTION_DAYS=

# boolean; server; default/status: true. Require a second factor (TOTP, aal2) for owner actions. Must be true in production.
OWNER_MFA_REQUIRED=true

# integer; server; default/status: 80. Max characters in a workspace name (database hard limit 120).
WORKSPACE_NAME_MAX_LENGTH=80

# integer; server; default/status: 80. Max characters in a brand name (database hard limit 120).
BRAND_NAME_MAX_LENGTH=80

# integer; server; default/status: 8192. Max serialized bytes of a brand's profile or targets object (hard limit 16384).
BRAND_SETTINGS_MAX_BYTES=8192

# integer; server; default/status: 20. Max active brands per workspace (application check; concurrent creates may briefly exceed it).
MAX_BRANDS_PER_WORKSPACE=20

# integer; server; default/status: 500. Max characters in an owner review note (hard limit 500).
REVIEW_NOTE_MAX_LENGTH=500

# integer; server; default/status: 32768. Max JSON request body size in bytes for API routes.
MAX_REQUEST_BODY_BYTES=32768
